config VDUSE_GUEST
	bool
	select VHOST_RING
	help
	  The guest side of a VDUSE device: a transport that serves the
	  virtqueues of a VDUSE device on the host, and backends that
	  implement device types. A host, such as UML, selects this and
	  gives the transport its access to VDUSE.

config VDUSE_GUEST_BLK
	bool "VDUSE virtio-blk backend"
	depends on VDUSE_GUEST && BLOCK
	default y
	help
	  Export a block device of the guest to the host as a virtio-blk
	  device.

config VDUSE_GUEST_PCI
	bool "VDUSE devices through a VMM's VDUSE proxy"
	depends on PCI_MSI && 64BIT && !UML
	select VDUSE_GUEST
	help
	  Serve a VDUSE device on the host from a VM, through the VDUSE
	  proxy PCI device of InvirtIO's fork of Cloud Hypervisor. Devices
	  are given with vduse_guest.device=.
