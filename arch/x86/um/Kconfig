menu "Host processor type and features"

source "arch/x86/Kconfig.cpu"

endmenu

config UML_X86
	def_bool y
	select ARCH_HAS_KERNEL_FPU_SUPPORT if 64BIT
	select ARCH_USE_QUEUED_RWLOCKS
	select ARCH_SUPPORTS_ATOMIC_RMW
	select ARCH_USE_QUEUED_SPINLOCKS
	select DCACHE_WORD_ACCESS
	select HAVE_EFFICIENT_UNALIGNED_ACCESS
	select UML_SUBARCH_SUPPORTS_SMP if X86_CX8

config 64BIT
	bool "64-bit kernel" if "$(SUBARCH)" = "x86"
	default "$(SUBARCH)" != "i386"

config X86_32
	def_bool !64BIT
	select ARCH_32BIT_OFF_T
	select ARCH_WANT_IPC_PARSE_VERSION
	select MODULES_USE_ELF_REL
	select CLONE_BACKWARDS
	select OLD_SIGSUSPEND3
	select OLD_SIGACTION

config X86_64
	def_bool 64BIT
	select MODULES_USE_ELF_RELA

config UML_LARGE_CODE_MODEL
	bool "Build the kernel with the large code model"
	depends on 64BIT
	help
	  The kernel is linked at 0x60000000 and normally built with the
	  small code model, which needs the whole image, including its bss,
	  to end below 2 GB. That leaves room for about 512 MB. Say Y if
	  linking the kernel fails with "relocation truncated to fit" errors,
	  as it can with allyesconfig.

	  If unsure, say N.

config ARCH_HAS_SC_SIGNALS
	def_bool !64BIT

config GENERIC_HWEIGHT
	def_bool y
